# Copie este arquivo para .env e ajuste conforme o ambiente.
# O sistema usa .env apenas se você carregá-lo (ex: python-dotenv).
# Alternativa: defina as variáveis diretamente no sistema operacional.

# URL pública usada nos links enviados por e-mail.
# Padrão (sem esta variável): https://estoque.upgradecontabilidade.com
APP_URL=https://estoque.upgradecontabilidade.com

# Chave secreta para assinar tokens JWT (gere uma nova para produção).
# ESTOQUE_SECRET_KEY=<string-aleatoria-longa>

# Origens permitidas no CORS (separadas por vírgula).
# CORS_ORIGINS=https://estoque.upgradecontabilidade.com
